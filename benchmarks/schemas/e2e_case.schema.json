{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amc.dev/benchmarks/e2e_case.schema.json",
  "title": "Full-Loop End-to-End Case",
  "description": "Layer-4 case (SPEC-005 §13). English -> verified gameplay.",
  "type": "object",
  "required": ["case_id", "category", "initial_state_fixture", "request", "required_verification"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^E2E-[A-Z0-9]+-\\d+$" },
    "category": {
      "enum": ["create", "modify", "reference", "clarification", "unsupported", "rollback", "runtime"]
    },
    "initial_state_fixture": { "type": "string", "minLength": 1 },
    "request": { "type": "string", "minLength": 1 },
    "expected_operations": { "type": "array" },
    "expected_state_assertions": { "type": "array" },
    "required_verification": {
      "type": "array",
      "items": {
        "enum": [
          "schema",
          "semantic",
          "build",
          "server_boot",
          "registry",
          "gametest",
          "persistence",
          "client_smoke"
        ]
      }
    },
    "expected_runtime_assertions": { "type": "array" },
    "maximum_retries": { "type": "integer", "minimum": 0 }
  }
}
