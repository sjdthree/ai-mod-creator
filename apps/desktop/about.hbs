<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Third-party licenses</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 960px; margin: 0 auto; padding: 16px; }
  pre { white-space: pre-wrap; background: #f6f6f6; padding: 12px; }
  li { margin: 2px 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Rust crates compiled into this program, grouped by license.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licenses</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
