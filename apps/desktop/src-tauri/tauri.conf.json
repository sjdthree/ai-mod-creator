{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-mod creator",
  "version": "0.3.0",
  "identifier": "io.github.sjdthree.aimodcreator",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI-mod creator",
        "width": 1120,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/amc", "binaries/llama-server"],
    "resources": ["resources/models", "resources/amc-ops.gbnf", "resources/licenses"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
