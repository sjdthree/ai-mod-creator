{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mod Creation Engine",
  "version": "0.3.0",
  "identifier": "com.modcreationengine.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mod Creation Engine",
        "width": 1120,
        "height": 780,
        "minWidth": 860,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/mce", "binaries/llama-server"],
    "resources": ["resources/models", "resources/mce-ops.gbnf", "resources/licenses"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
