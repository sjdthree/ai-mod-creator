{
  "name": "amc",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "mounts": [
    "source=amc-cargo,target=/home/dev/.cargo/registry,type=volume",
    "source=amc-gradle,target=/home/dev/.gradle,type=volume",
    "source=amc-target,target=/home/dev/target,type=volume"
  ],
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "vscjava.vscode-java-pack"]
    }
  }
}
