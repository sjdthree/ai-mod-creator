{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amc.dev/schemas/0.1.0/behavior.schema.json",
  "title": "MCL Behavior Document",
  "description": "Restricted trigger-condition-action behavior (SPEC-004 §18). No arbitrary code.",
  "type": "object",
  "required": ["schema_version", "document_type", "document_id", "revision", "behavior"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "document_type": { "const": "behavior" },
    "document_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "behavior": {
      "type": "object",
      "required": ["behavior_id", "target", "trigger", "actions", "status"],
      "properties": {
        "behavior_id": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/reference" },
        "trigger": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": [
                "player_uses_item",
                "player_hits_entity",
                "player_breaks_block",
                "entity_is_hurt",
                "item_is_crafted",
                "block_is_placed"
              ]
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "random_chance",
                  "is_night",
                  "player_health_below",
                  "target_is_entity_type",
                  "player_has_effect",
                  "player_is_holding"
                ]
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "deal_damage",
                  "heal_player",
                  "apply_effect",
                  "play_sound",
                  "spawn_particles",
                  "give_item",
                  "remove_item",
                  "set_block"
                ]
              }
            }
          }
        },
        "status": { "enum": ["active", "deleted"] }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["reference_type", "value"],
      "properties": {
        "reference_type": {
          "enum": ["concept_id", "namespace_id", "display_name", "alias", "selector", "minecraft_id"]
        },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
