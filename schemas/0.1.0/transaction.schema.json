{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mce.dev/schemas/0.1.0/transaction.schema.json",
  "title": "MCL Transaction Document",
  "description": "A candidate/committed transaction (SPEC-004 §31). Only verified transactions become canonical.",
  "type": "object",
  "required": ["schema_version", "document_type", "document_id", "revision", "transaction"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "document_type": { "const": "transaction" },
    "document_id": { "type": "string", "minLength": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "transaction": {
      "type": "object",
      "required": ["transaction_id", "status"],
      "properties": {
        "transaction_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string" },
        "request_text": { "type": "string" },
        "parent_transaction_id": { "type": ["string", "null"] },
        "input_state_hash": { "type": "string" },
        "operations": { "type": "array" },
        "normalized_operations": { "type": "array" },
        "candidate_state_hash": { "type": "string" },
        "generator_version": { "type": "string" },
        "adapter_version": { "type": "string" },
        "model_version": { "type": "string" },
        "verification_report_id": { "type": "string" },
        "status": {
          "enum": [
            "proposed",
            "validated",
            "generated",
            "build_failed",
            "verification_failed",
            "verified",
            "committed",
            "rejected"
          ]
        },
        "committed_at": { "type": "string" }
      }
    }
  }
}
